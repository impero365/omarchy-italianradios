#!/usr/bin/env python3
"""Save station logos after the stream proxy's public-address check.

The panel never loads a directory icon URL itself. Each HTTP or HTTPS image is
resolved and refused when any answer is private, local, or locally routed.
The connection uses the address that passed that check. A redirect is fetched
only when its target passes the same check. The cached file is a PNG, JPEG,
WebP, GIF, or ICO. Logos the current directory no longer uses are removed,
and the icon directory stays within CACHE_MAX_BYTES. The cache and icon
directories must be real directories. Cleanup removes only regular files
whose names match a logo this plugin stores.
"""

import errno
import hashlib
import http.client
import importlib.machinery
import importlib.util
import json
import os
import re
import ssl
import stat
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from urllib.parse import urljoin, urlsplit

MAX_BODY = 1_048_576
MAX_URLS = 2500
MAX_REDIRECTS = 4
FETCH_WORKERS = 8
FETCH_TIMEOUT = 4
BLOCK_TTL = 24 * 60 * 60
READ_LIMIT = 4_000_000
# The live directory is a few hundred small logos. The cap stops a changing
# directory from keeping every logo it has ever seen.
CACHE_MAX_BYTES = 64 * 1024 * 1024
ICON_NAME = re.compile(r"^[a-f0-9]{64}\.(png|jpe?g|gif|webp|ico)$")
REDIRECTS = {301, 302, 303, 307, 308}
SKIPPED = object()


def load_proxy():
    path = Path(__file__).resolve().with_name("radio-proxy")
    loader = importlib.machinery.SourceFileLoader("radio_proxy_icon", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


proxy = load_proxy()


class IconDenied(Exception):
    """This URL is not a public image we can store."""


class FetchFailed(Exception):
    """The image could not be fetched. A later run may try again."""


def parse_icon_url(url):
    if not isinstance(url, str) or not 12 <= len(url) <= 500:
        raise IconDenied()
    if any(ord(ch) < 32 or ord(ch) == 127 or ch in ' <>"\'\\' for ch in url):
        raise IconDenied()
    try:
        parts = urlsplit(url)
        port = parts.port
    except ValueError as error:
        raise IconDenied() from error
    scheme = parts.scheme.lower()
    if scheme not in ("http", "https") or not parts.hostname:
        raise IconDenied()
    if port is None:
        port = 443 if scheme == "https" else 80
    if parts.username is not None or parts.password is not None or parts.fragment:
        raise IconDenied()
    if not 1 <= port <= 65_535:
        raise IconDenied()
    bare = (parts.path or "").lower()
    if not bare.endswith((".png", ".jpg", ".jpeg", ".webp", ".gif", ".ico")):
        raise IconDenied()
    return parts


def sniff(body):
    if len(body) < 8 or len(body) > MAX_BODY:
        return ""
    if body.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png"
    if body.startswith(b"\xff\xd8\xff"):
        return "jpg"
    if body.startswith((b"GIF87a", b"GIF89a")):
        return "gif"
    if body[:4] == b"RIFF" and body[8:12] == b"WEBP":
        return "webp"
    if body[:4] == b"\x00\x00\x01\x00":
        return "ico"
    return ""


def open_public(host, port):
    """Connect to the address that just passed the public-address check."""
    raw = proxy.connect_public(host, port, timeout=FETCH_TIMEOUT)
    raw.settimeout(FETCH_TIMEOUT)
    return raw


def open_public_tls(host, port):
    """Connect to the checked address, then verify the certificate for host."""
    raw = open_public(host, port)
    try:
        return ssl.create_default_context().wrap_socket(raw, server_hostname=host)
    except Exception:
        raw.close()
        raise


def exchange(url):
    parts = parse_icon_url(url)
    scheme = parts.scheme.lower()
    host = parts.hostname
    port = parts.port or (443 if scheme == "https" else 80)
    path = parts.path or "/"
    if parts.query:
        path += "?" + parts.query
    connection = http.client.HTTPSConnection if scheme == "https" else http.client.HTTPConnection
    conn = connection(host, port, timeout=FETCH_TIMEOUT)

    def connect_checked():
        conn.sock = open_public_tls(host, port) if scheme == "https" else open_public(host, port)

    conn.connect = connect_checked
    try:
        try:
            conn.request(
                "GET",
                path,
                headers={
                    "User-Agent": "impero365.radio-italia/1.0",
                    "Accept": "image/png, image/jpeg, image/webp, image/gif, image/x-icon",
                    "Connection": "close",
                },
            )
            response = conn.getresponse()
        except proxy.ProxyError:
            raise
        except (OSError, http.client.HTTPException, ssl.SSLError, TimeoutError, UnicodeEncodeError) as error:
            raise FetchFailed() from error
        length = response.getheader("Content-Length")
        if length is not None:
            try:
                announced = int(length)
            except ValueError as error:
                raise IconDenied() from error
            if announced > MAX_BODY:
                raise IconDenied()
        try:
            body = response.read(MAX_BODY + 1)
        except (OSError, http.client.HTTPException, ssl.SSLError, TimeoutError) as error:
            raise FetchFailed() from error
        if len(body) > MAX_BODY:
            raise IconDenied()
        headers = {name.lower(): value for name, value in response.getheaders()}
        return response.status, headers, body
    finally:
        conn.close()


def resolve_redirect(current, location):
    if not isinstance(location, str) or any(ord(ch) < 32 or ord(ch) == 127 for ch in location):
        raise IconDenied()
    target = urljoin(current, location.strip())
    parse_icon_url(target)
    return target


def fetch_bytes(url, send=None):
    if send is None:
        send = exchange
    current = url
    for _ in range(MAX_REDIRECTS + 1):
        parse_icon_url(current)
        try:
            status, headers, body = send(current)
        except proxy.ProxyError as error:
            if error.status.startswith(b"403"):
                raise IconDenied() from error
            raise FetchFailed() from error
        except IconDenied:
            raise
        except FetchFailed:
            raise
        except (OSError, http.client.HTTPException, ssl.SSLError, TimeoutError) as error:
            raise FetchFailed() from error
        if status in REDIRECTS:
            found = ""
            for name, value in headers.items():
                if str(name).lower() == "location":
                    found = value
            current = resolve_redirect(current, found)
            continue
        if status != 200:
            raise IconDenied()
        kind = sniff(body)
        if not kind:
            raise IconDenied()
        return kind, body
    raise IconDenied()


def safe_path(path):
    if not isinstance(path, str) or not path or "\0" in path or not os.path.isabs(path):
        raise SystemExit(2)
    if any(part == ".." for part in path.split("/")):
        raise SystemExit(2)
    return os.path.normpath(path)


def icon_urls(path):
    if not path or not os.path.isfile(path):
        return []
    try:
        if os.path.getsize(path) > READ_LIMIT:
            return []
        with open(path, "rb") as handle:
            data = json.loads(handle.read())
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return []
    rows = data.get("stations") if isinstance(data, dict) else data if isinstance(data, list) else None
    if not isinstance(rows, list):
        return []
    found = []
    for row in rows:
        if isinstance(row, dict) and isinstance(row.get("icon"), str):
            found.append(row["icon"])
    return found


def load_state_at(dir_fd):
    state = {"icons": {}, "blocked": {}}
    try:
        raw = read_at(dir_fd, "icons.json", READ_LIMIT)
        if len(raw) > READ_LIMIT:
            return state
        data = json.loads(raw)
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return state
    if not isinstance(data, dict):
        return state
    now = time.time()
    icons = data.get("icons")
    blocked = data.get("blocked")
    if isinstance(icons, dict):
        for url, name in icons.items():
            if isinstance(url, str) and isinstance(name, str) and ICON_NAME.fullmatch(name):
                state["icons"][url] = name
    if isinstance(blocked, dict):
        for url, when in blocked.items():
            if isinstance(url, str) and isinstance(when, (int, float)) and 0 <= now - when < BLOCK_TTL:
                state["blocked"][url] = when
    return state


def open_real_directory(path, parent_fd=None):
    """Open a real directory. An existing symlink is refused and left in place."""
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    kwargs = {"dir_fd": parent_fd} if parent_fd is not None else {}
    try:
        fd = os.open(path, flags, **kwargs)
    except FileNotFoundError:
        os.mkdir(path, 0o700, **kwargs)
        fd = os.open(path, flags, **kwargs)
    try:
        os.fchmod(fd, 0o700)
    except Exception:
        os.close(fd)
        raise
    return fd


def read_at(dir_fd, name, limit):
    """Read a regular file in dir_fd. A symlink is not followed."""
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dir_fd)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise OSError(errno.ELOOP, "cache entry is not a regular file")
        chunks = []
        remaining = limit + 1
        while remaining > 0:
            block = os.read(fd, min(remaining, 65536))
            if not block:
                break
            chunks.append(block)
            remaining -= len(block)
        return b"".join(chunks)
    finally:
        os.close(fd)


def atomic_write_at(dir_fd, name, payload):
    """Replace a regular file in dir_fd. A symlink or other entry is left in place."""
    try:
        info = os.lstat(name, dir_fd=dir_fd)
    except FileNotFoundError:
        info = None
    if info is not None and not stat.S_ISREG(info.st_mode):
        raise OSError(errno.ELOOP, "refusing to replace a cache entry that is not a regular file")
    tmp = ".icon-%s" % os.urandom(8).hex()
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dir_fd)
    try:
        view = memoryview(payload)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise OSError(errno.EIO, "cache write made no progress")
            view = view[written:]
        os.fsync(fd)
    except Exception:
        os.close(fd)
        os.unlink(tmp, dir_fd=dir_fd)
        raise
    os.close(fd)
    os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)


def write_state_at(dir_fd, state):
    payload = json.dumps(
        {"blocked": state["blocked"], "icons": state["icons"]},
        separators=(",", ":"),
        sort_keys=True,
    ).encode() + b"\n"
    atomic_write_at(dir_fd, "icons.json", payload)


def remember(state, cache_fd, url, filename):
    if filename:
        state["icons"][url] = filename
        state["blocked"].pop(url, None)
    else:
        state["blocked"][url] = time.time()
        state["icons"].pop(url, None)
    write_state_at(cache_fd, state)


class ByteBudget:
    """Bytes still available under the icon-directory cap."""

    def __init__(self, remaining):
        self.remaining = max(0, remaining)
        self.lock = threading.Lock()

    def reserve(self, size):
        with self.lock:
            if size > self.remaining:
                return False
            self.remaining -= size
            return True

    def release(self, size):
        with self.lock:
            self.remaining += size


def unlink_logo(icons_fd, name):
    """Remove one regular logo file. Another kind of directory entry is left in place."""
    if not ICON_NAME.fullmatch(name):
        return False
    info = os.lstat(name, dir_fd=icons_fd)
    if not stat.S_ISREG(info.st_mode):
        return False
    os.unlink(name, dir_fd=icons_fd)
    return True


def trim_cache(state, icons_fd, wanted):
    """Drop logos the current directory no longer uses, then the oldest files past the cap."""
    changed = False
    for url in list(state["icons"]):
        if url not in wanted:
            del state["icons"][url]
            changed = True
    for url in list(state["blocked"]):
        if url not in wanted:
            del state["blocked"][url]
            changed = True

    keep = {}
    for url, name in state["icons"].items():
        keep.setdefault(name, []).append(url)

    kept = []
    total = 0
    for name in os.listdir(icons_fd):
        if not ICON_NAME.fullmatch(name):
            continue
        try:
            info = os.lstat(name, dir_fd=icons_fd)
        except OSError:
            continue
        if not stat.S_ISREG(info.st_mode):
            continue
        if name not in keep:
            try:
                if unlink_logo(icons_fd, name):
                    changed = True
            except OSError:
                continue
            continue
        kept.append((info.st_mtime, name, info.st_size))
        total += info.st_size

    kept.sort()
    while total > CACHE_MAX_BYTES and kept:
        _mtime, name, size = kept.pop(0)
        try:
            if not unlink_logo(icons_fd, name):
                continue
        except OSError:
            continue
        for url in keep.get(name, ()):
            state["icons"].pop(url, None)
        total -= size
        changed = True
    return changed, max(0, total)


def fetch_one(url, icons_fd, fetch, budget):
    try:
        _kind, body = fetch(url)
        ext = sniff(body)
        if not ext:
            raise IconDenied()
    except IconDenied:
        return url, ""
    except FetchFailed:
        return url, None
    if not budget.reserve(len(body)):
        return url, SKIPPED
    filename = hashlib.sha256(url.encode("utf-8")).hexdigest() + "." + ext
    try:
        atomic_write_at(icons_fd, filename, body)
    except Exception:
        budget.release(len(body))
        raise
    return url, filename


def regular_logo(icons_fd, name):
    if not name or not ICON_NAME.fullmatch(name):
        return False
    try:
        info = os.lstat(name, dir_fd=icons_fd)
    except OSError:
        return False
    return stat.S_ISREG(info.st_mode)


def sync(cache, urls, fetch=fetch_bytes):
    cache = safe_path(cache)
    cache_fd = open_real_directory(cache)
    try:
        icons_fd = open_real_directory("icons", cache_fd)
        try:
            return sync_open(cache_fd, icons_fd, urls, fetch)
        finally:
            os.close(icons_fd)
    finally:
        os.close(cache_fd)


def sync_open(cache_fd, icons_fd, urls, fetch):
    state = load_state_at(cache_fd)
    wanted = []
    seen = set()
    for url in urls:
        if url in seen or len(seen) >= MAX_URLS:
            continue
        seen.add(url)
        try:
            parse_icon_url(url)
        except IconDenied:
            continue
        wanted.append(url)
    changed, used = trim_cache(state, icons_fd, set(wanted))
    if changed:
        write_state_at(cache_fd, state)
    pending = []
    for url in wanted:
        name = state["icons"].get(url)
        if regular_logo(icons_fd, name):
            continue
        blocked_at = state["blocked"].get(url)
        if blocked_at is not None and time.time() - float(blocked_at) < BLOCK_TTL:
            continue
        pending.append(url)
    if not pending:
        return state
    budget = ByteBudget(CACHE_MAX_BYTES - used)
    workers = min(FETCH_WORKERS, len(pending))
    with ThreadPoolExecutor(max_workers=workers) as pool:
        futures = [pool.submit(fetch_one, url, icons_fd, fetch, budget) for url in pending]
        for done in as_completed(futures):
            url, filename = done.result()
            if filename is None or filename is SKIPPED:
                continue
            remember(state, cache_fd, url, filename)
    return state


def main(argv=None):
    if argv is None:
        argv = sys.argv
    if len(argv) not in (2, 3):
        raise SystemExit(2)
    cache = safe_path(argv[1])
    favorites = safe_path(argv[2]) if len(argv) == 3 and argv[2] else ""
    os.umask(0o077)
    urls = icon_urls(os.path.join(cache, "stations.json"))
    if favorites:
        urls.extend(icon_urls(favorites))
    sync(cache, urls)


if __name__ == "__main__":
    main()
