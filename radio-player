#!/usr/bin/env bash
# Forward one player command to the long-lived player process.
# The panel keeps calling this program. The process stays up, so a later
# click does not start Python again.

set -euo pipefail
umask 077

usage() {
  echo "usage: radio-player play ID NAME URL | pause | resume | toggle | stop | status" >&2
  exit 2
}

fail() {
  printf '%s\n' '{"running":false,"paused":false,"idle":true,"starting":false,"id":"","name":"","error":true,"reason":"no-player"}'
  exit 4
}

runtime_root=${XDG_RUNTIME_DIR:-}
[[ $runtime_root == /* ]] || fail
[[ $runtime_root != *..* ]] || fail
[[ ! $runtime_root =~ [[:space:][:cntrl:]] ]] || fail
runtime=${runtime_root%/}/mattia.radio
install -d -m 700 -- "$runtime"

if [[ $# -eq 0 ]]; then
  set -- status
fi
case "$1" in
  play)
    [[ $# -eq 4 ]] || usage
    ;;
  pause|resume|toggle|stop|status)
    [[ $# -eq 1 ]] || usage
    ;;
  *)
    usage
    ;;
esac

command -v socat >/dev/null 2>&1 || fail
command -v python3 >/dev/null 2>&1 || fail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
socket=$runtime/player.cmd.sock
pid_file=$runtime/player-command.pid
log=$runtime/player-command.log
daemon=$script_dir/radio-playerd

process_start() {
  local pid=$1
  [[ -r /proc/$pid/stat ]] || return 1
  awk -F ') ' 'NF > 1 { print $2 }' "/proc/$pid/stat" | awk '$1 != "Z" { print $20 }'
}

# Print the live command pid when it is the process recorded in the pid file.
recorded_pid() {
  local pid start actual
  [[ -s $pid_file ]] || return 1
  read -r pid start _stamp < "$pid_file" || return 1
  [[ $pid =~ ^[0-9]+$ && $start =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  actual=$(process_start "$pid") || return 1
  [[ $actual == "$start" ]] || return 1
  printf '%s\n' "$pid"
}

command_current() {
  local pid stamp current
  pid=$(recorded_pid) || return 1
  [[ -S $socket ]] || return 1
  read -r _pid _start stamp < "$pid_file" || return 1
  current=$(stat -c %Y -- "$daemon") || return 1
  [[ $stamp == "$current" ]]
}

stop_recorded() {
  local pid
  pid=$(recorded_pid) || return 0
  kill "$pid" 2>/dev/null || true
  local _
  for _ in $(seq 1 50); do
    recorded_pid >/dev/null || return 0
    sleep 0.02
  done
  return 1
}

exec 9>"$runtime/player-command.lock"
flock 9
if ! command_current; then
  stop_recorded || { flock -u 9; fail; }
  rm -f -- "$socket" "$pid_file"
  PYTHONUNBUFFERED=1 python3 "$daemon" >>"$log" 2>&1 &
  started=0
  for _ in $(seq 1 150); do
    if command_current; then
      started=1
      break
    fi
    sleep 0.02
  done
  [[ $started -eq 1 ]] || { flock -u 9; fail; }
fi
flock -u 9

payload=""
for arg in "$@"; do
  n=$(printf '%s' "$arg" | wc -c)
  n=${n//[[:space:]]/}
  printf -v piece '%s:%s,' "$n" "$arg"
  payload+=$piece
done

set +e
output=$(printf '%s' "$payload" | socat -T 20 - "UNIX-CONNECT:${socket}")
socat_status=$?
set -e
[[ $socat_status -eq 0 ]] || fail
[[ $output == *$'\n'* ]] || fail
code=${output##*$'\n'}
json=${output%$'\n'*}
[[ $json == \{* && $code =~ ^[0-9]+$ ]] || fail
printf '%s\n' "$json"
exit "$code"
