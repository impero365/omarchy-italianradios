#!/usr/bin/env python3
"""HTTP proxy that opens only public stream addresses.

mpv runs without a network of its own and sends every request here. A station
listing can name a private host or redirect to one, so each destination is
resolved and checked before a connection is opened.
"""

import argparse
import ipaddress
import json
import os
import select
import signal
import socket
import socketserver
import stat
import subprocess
import sys
import threading
from urllib.parse import urlsplit

MAX_HEADER_BYTES = 65_536
MAX_ACTIVE_CONNECTIONS = 32
MAX_ANSWERS = 16
NAT64 = ipaddress.ip_network("64:ff9b::/96")
IPV4_COMPATIBLE = ipaddress.ip_network("::/96")


class ProxyError(Exception):
    def __init__(self, status, detail=""):
        self.status = status
        self.detail = detail


class RouteUnavailable(Exception):
    """This address has no route. Another address for the same name may still work."""


def embedded_ipv4(ip):
    if not isinstance(ip, ipaddress.IPv6Address):
        return []
    found = []
    if ip.ipv4_mapped:
        found.append(ip.ipv4_mapped)
    if ip.sixtofour:
        found.append(ip.sixtofour)
    if ip.teredo:
        found.extend(ip.teredo)
    if ip in NAT64 or ip in IPV4_COMPATIBLE:
        found.append(ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF))
    return found


def blocked_address(ip):
    nat64 = isinstance(ip, ipaddress.IPv6Address) and ip in NAT64
    if (
        ip.is_multicast
        or ip.is_unspecified
        or ip.is_loopback
        or ip.is_link_local
        or getattr(ip, "is_site_local", False)
    ):
        return True
    if ip.is_reserved and not nat64:
        return True
    if not ip.is_global and not nat64:
        return True
    return False


def address_allowed(ip):
    if not isinstance(ip, (ipaddress.IPv4Address, ipaddress.IPv6Address)):
        ip = ipaddress.ip_address(str(ip).split("%", 1)[0])
    if blocked_address(ip):
        return False
    return not any(blocked_address(other) for other in embedded_ipv4(ip))


def route_is_local(ip):
    try:
        result = subprocess.run(
            ["/usr/bin/ip", "-j", "route", "get", str(ip)],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            check=False,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RouteUnavailable() from error
    if result.returncode != 0:
        raise RouteUnavailable()
    try:
        routes = json.loads(result.stdout)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise RouteUnavailable() from error
    if not isinstance(routes, list):
        raise RouteUnavailable()
    return any(
        isinstance(route, dict)
        and (route.get("type") == "local" or route.get("dev") == "lo")
        for route in routes
    )


def public_endpoints(host, port):
    try:
        answers = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
    except socket.gaierror as error:
        raise ProxyError(b"502 Bad Gateway") from error

    endpoints = []
    seen = set()
    for family, kind, protocol, _, address in answers:
        key = (family, address)
        if key in seen:
            continue
        seen.add(key)
        if len(seen) > MAX_ANSWERS:
            raise ProxyError(b"502 Bad Gateway")
        ip = ipaddress.ip_address(str(address[0]).split("%", 1)[0])
        if not address_allowed(ip):
            raise ProxyError(b"403 Forbidden")
        try:
            local = route_is_local(ip)
        except RouteUnavailable:
            continue
        if local:
            raise ProxyError(b"403 Forbidden")
        endpoints.append((family, kind, protocol, address))
    # Use a working IPv4 address before any IPv6 address.
    endpoints.sort(key=lambda endpoint: endpoint[0] != socket.AF_INET)
    if not endpoints:
        raise ProxyError(b"502 Bad Gateway")
    return endpoints


def connect_public(host, port, timeout=12):
    last_error = None
    for family, kind, protocol, address in public_endpoints(host, port):
        upstream = None
        try:
            upstream = socket.socket(family, kind, protocol)
            upstream.settimeout(timeout)
            upstream.connect(address)
            return upstream
        except OSError as error:
            last_error = error
            if upstream is not None:
                upstream.close()
    raise ProxyError(b"502 Bad Gateway") from last_error


def parse_authority(authority, default_port):
    try:
        target = urlsplit(f"//{authority}")
        host = target.hostname
        port = target.port
        if port is None:
            port = default_port
    except ValueError as error:
        raise ProxyError(b"400 Bad Request", "authority") from error
    if not host or target.username is not None or target.password is not None:
        raise ProxyError(b"400 Bad Request", "authority")
    if target.path or target.query or target.fragment or not 1 <= port <= 65_535:
        raise ProxyError(b"400 Bad Request", "authority")
    return host, port


def read_header(client):
    data = bytearray()
    while b"\r\n\r\n" not in data:
        chunk = client.recv(min(16_384, MAX_HEADER_BYTES - len(data) + 1))
        if not chunk:
            raise ProxyError(b"400 Bad Request", "truncated")
        data.extend(chunk)
        if len(data) > MAX_HEADER_BYTES:
            raise ProxyError(b"431 Request Header Fields Too Large", "header")
    boundary = data.index(b"\r\n\r\n") + 4
    return bytes(data[:boundary]), bytes(data[boundary:])


def parse_request(header):
    lines = header[:-4].split(b"\r\n")
    try:
        method, target, version = lines[0].decode("ascii").split(" ")
    except (UnicodeDecodeError, ValueError) as error:
        raise ProxyError(b"400 Bad Request", "request-line") from error
    if version not in {"HTTP/1.0", "HTTP/1.1"}:
        raise ProxyError(b"400 Bad Request", "version")

    headers = []
    for line in lines[1:]:
        if not line or line[:1].isspace() or b":" not in line:
            raise ProxyError(b"400 Bad Request", "header")
        name, _ = line.split(b":", 1)
        try:
            normalized = name.decode("ascii").lower()
        except UnicodeDecodeError as error:
            raise ProxyError(b"400 Bad Request", "header") from error
        if normalized not in {"proxy-connection", "connection", "host"}:
            headers.append(line)

    if method == "CONNECT":
        host, port = parse_authority(target, 443)
        return method, host, port, b""

    if method not in {"GET", "HEAD"}:
        raise ProxyError(b"405 Method Not Allowed")
    try:
        destination = urlsplit(target)
        port = destination.port
        if port is None:
            port = 80
    except ValueError as error:
        raise ProxyError(b"400 Bad Request", "target") from error
    if destination.scheme.lower() != "http" or not destination.hostname:
        raise ProxyError(b"400 Bad Request", "scheme")
    if destination.username is not None or destination.password is not None:
        raise ProxyError(b"400 Bad Request", "userinfo")
    if destination.fragment or not 1 <= port <= 65_535:
        raise ProxyError(b"400 Bad Request", "target")

    path = destination.path or "/"
    if destination.query:
        path += "?" + destination.query
    try:
        request_line = f"{method} {path} {version}".encode("ascii")
        host_header = destination.netloc.encode("ascii")
    except UnicodeEncodeError as error:
        raise ProxyError(b"400 Bad Request", "encoding") from error
    forwarded = b"\r\n".join(
        [request_line, *headers, b"Host: " + host_header, b"Connection: close", b"", b""]
    )
    return method, destination.hostname, port, forwarded


def relay(left, right):
    while True:
        readable, _, _ = select.select((left, right), (), (), 60)
        if not readable:
            return "idle_timeout"
        for source in readable:
            data = source.recv(65_536)
            if not data:
                return "client_closed" if source is left else "upstream_closed"
            (right if source is left else left).sendall(data)


def log_outcome(stage, outcome):
    print(f"radio-proxy: stage={stage} outcome={outcome}", file=sys.stderr, flush=True)


class ProxyHandler(socketserver.BaseRequestHandler):
    def handle(self):
        self.request.settimeout(12)
        stage = "request"
        try:
            try:
                header, pending = read_header(self.request)
            except ProxyError as error:
                error.detail = error.detail or "header"
                raise
            method, host, port, forwarded = parse_request(header)
            stage = "connect"
            with connect_public(host, port) as upstream:
                stage = "relay"
                if method == "CONNECT":
                    self.request.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
                else:
                    upstream.sendall(forwarded)
                if pending:
                    upstream.sendall(pending)
                log_outcome(stage, relay(self.request, upstream))
        except ProxyError as error:
            if error.status.startswith(b"403"):
                log_outcome(stage, "forbidden")
            else:
                detail = f" detail={error.detail}" if error.detail else ""
                log_outcome(stage, "rejected" + detail)
            try:
                self.request.sendall(b"HTTP/1.1 " + error.status + b"\r\nConnection: close\r\n\r\n")
            except OSError:
                return
        except OSError:
            log_outcome(stage, "failed")


class ProxyServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    request_queue_size = 32
    allow_reuse_address = True

    def __init__(self, *args, **kwargs):
        self.connection_slots = threading.BoundedSemaphore(MAX_ACTIVE_CONNECTIONS)
        super().__init__(*args, **kwargs)

    def process_request(self, request, client_address):
        if not self.connection_slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self.connection_slots.release()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.connection_slots.release()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("socket")
    args = parser.parse_args()
    path = args.socket
    if os.path.exists(path):
        if not stat.S_ISSOCK(os.stat(path).st_mode):
            raise SystemExit("Proxy path exists and is not a socket")
        os.unlink(path)

    os.umask(0o077)
    server = ProxyServer(path, ProxyHandler)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    try:
        server.serve_forever()
    finally:
        server.server_close()
        if os.path.exists(path):
            os.unlink(path)


if __name__ == "__main__":
    main()
