#!/usr/bin/env bash
# Bridge the network-less player to the host proxy, then run the player.
set -euo pipefail

runtime_dir=$1
shift
bridge_pid=""

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM
  [[ -z $bridge_pid ]] || kill "$bridge_pid" 2>/dev/null || true
  [[ -z $bridge_pid ]] || wait "$bridge_pid" 2>/dev/null || true
  exit "$exit_code"
}
trap cleanup EXIT INT TERM

(
  exec socat TCP4-LISTEN:18765,bind=127.0.0.1,reuseaddr,fork,max-children=32 \
    UNIX-CONNECT:"$runtime_dir/proxy.sock"
) >/dev/null 2>&1 &
bridge_pid=$!
for _ in $(seq 1 100); do
  if (: > /dev/tcp/127.0.0.1/18765) 2>/dev/null; then
    break
  fi
  kill -0 "$bridge_pid" 2>/dev/null || break
  sleep 0.02
done
kill -0 "$bridge_pid" 2>/dev/null

unset ALL_PROXY all_proxy
export http_proxy=http://127.0.0.1:18765
export https_proxy=$http_proxy
export HTTP_PROXY=$http_proxy
export HTTPS_PROXY=$http_proxy
export no_proxy=
export NO_PROXY=
"$@"
